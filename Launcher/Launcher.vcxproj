<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|Win32"><Configuration>Debug</Configuration><Platform>Win32</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|Win32"><Configuration>Release</Configuration><Platform>Win32</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64"><Configuration>Debug</Configuration><Platform>x64</Platform></ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>18.0</VCProjectVersion>
    <ProjectGuid>{92E08354-8697-438D-9FB9-0DDD4880E9C8}</ProjectGuid>
    <RootNamespace>BedrockLauncher</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <TargetName>BedrockLauncher</TargetName>
    <OutDir>$(ProjectDir)bin\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(ProjectDir)obj\$(Platform)\$(Configuration)\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <CompileAs>CompileAsC</CompileAs>
      <LanguageStandard_C>stdc17</LanguageStandard_C>
      <PreprocessorDefinitions>UNICODE;_UNICODE;WIN32_LEAN_AND_MEAN;_WIN32_WINNT=0x0A00;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <EntryPointSymbol>wmainCRTStartup</EntryPointSymbol>
      <AdditionalDependencies>winhttp.lib;ws2_32.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
    <Manifest>
      <AdditionalManifestFiles>$(ProjectDir)app.manifest;%(AdditionalManifestFiles)</AdditionalManifestFiles>
    </Manifest>
  </ItemDefinitionGroup>
  <ItemGroup><ClCompile Include="logging.c" /><ClCompile Include="main.c" /><ClCompile Include="inspector.c" /><ClCompile Include="fuse.c" /><ClCompile Include="shutdown.c" /></ItemGroup>
  <ItemGroup><ClInclude Include="logging.h" /><ClInclude Include="inspector.h" /><ClInclude Include="fuse.h" /><ClInclude Include="shutdown.h" /></ItemGroup>
  <ItemGroup><Manifest Include="app.manifest" /></ItemGroup>
  <ItemGroup><None Include="README.md" /></ItemGroup>
  <ItemGroup>
    <NoticeFile Include="$(MSBuildThisFileDirectory)..\third_party_notices.md" />
    <None Include="..\THIRD_PARTY_NOTICES.md" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Native\PluginHost\NativeController.vcxproj" Condition="'$(Platform)'=='x64'">
      <Project>{A2FF9A45-7F03-4FF1-9EC6-4D0EC3B384B5}</Project><LinkLibraryDependencies>false</LinkLibraryDependencies>
    </ProjectReference>
    <ProjectReference Include="..\Native\Console\Console.vcxproj">
      <Project>{91A18A72-459F-4D73-B9E0-894A284043EA}</Project>
      <LinkLibraryDependencies>false</LinkLibraryDependencies>
    </ProjectReference>
    <ProjectReference Include="..\Native\BackdropBlurFix\BackdropBlurFix.vcxproj" Condition="'$(Platform)'=='x64'">
      <Project>{50F5D8CB-66B9-4AA5-9C1A-43EA8C27A618}</Project>
      <LinkLibraryDependencies>false</LinkLibraryDependencies>
    </ProjectReference>
    <ProjectReference Include="..\Native\WindowCustomization\WindowCustomization.vcxproj">
      <Project>{D8312270-05D3-4BE3-B4E9-70D39F4CC127}</Project>
      <LinkLibraryDependencies>false</LinkLibraryDependencies>
    </ProjectReference>
  </ItemGroup>
  <PropertyGroup>
    <PluginArchitecture Condition="'$(Platform)'=='x64'">x64</PluginArchitecture>
    <PluginArchitecture Condition="'$(Platform)'=='Win32'">ia32</PluginArchitecture>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Target Name="PublishManagedRuntime" BeforeTargets="CopyBedrockRuntime">
    <Exec Command="dotnet publish &quot;$(ProjectDir)..\Managed\Host\Host.csproj&quot; -c $(Configuration) --nologo -o &quot;$(IntDir)managed-publish&quot;" />
    <ItemGroup><ManagedRuntimeFile Include="$(IntDir)managed-publish\wwwroot\**\*" /></ItemGroup>
    <Copy SourceFiles="@(ManagedRuntimeFile)" DestinationFiles="@(ManagedRuntimeFile->'$(OutDir)Runtime\dotnet\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyBedrockRuntime" AfterTargets="Build">
    <ItemGroup><PublicHeader Include="$(ProjectDir)..\include\bedrock\*.h" /></ItemGroup>
    <ItemGroup><RuntimeFile Include="$(ProjectDir)..\Runtime\*.cjs;$(ProjectDir)..\Runtime\*.mjs" /></ItemGroup>
    <ItemGroup><BundledPluginFile Include="$(ProjectDir)..\Plugins\**\*" /></ItemGroup>
    <Delete Files="$(OutDir)BedrockData\plugins\backdrop-blur\plugin.json;$(OutDir)BedrockData\plugins\backdrop-blur\main.js;$(OutDir)BedrockData\plugins\backdrop-blur\native\win32-x64\blur-controller.exe;$(OutDir)BedrockData\plugins\backdrop-blur\native\win32-x64\blur-hook.dll;$(OutDir)BedrockData\plugins\backdrop-blur\native\win32-x64\manual-map-LICENSE.txt" />
    <Copy SourceFiles="@(PublicHeader)" DestinationFolder="$(OutDir)include\bedrock" SkipUnchangedFiles="true" />
    <Copy Condition="'$(Platform)'=='x64'" SourceFiles="$(ProjectDir)..\Native\PluginHost\bin\$(Platform)\$(Configuration)\native-controller.exe;$(ProjectDir)..\Native\PluginHost\bin\$(Platform)\$(Configuration)\native-host.dll" DestinationFolder="$(OutDir)Runtime\native\win32-x64" SkipUnchangedFiles="true" />
    <Copy Condition="'$(Platform)'=='x64'" SourceFiles="$(ProjectDir)..\lib\manual-map\LICENSE" DestinationFiles="$(OutDir)Runtime\native\win32-x64\manual-map-LICENSE.txt" SkipUnchangedFiles="true" />
    <Copy Condition="'$(Platform)'=='x64'" SourceFiles="$(ProjectDir)..\lib\minhook\LICENSE.txt" DestinationFiles="$(OutDir)Runtime\native\win32-x64\minhook-LICENSE.txt" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(RuntimeFile)" DestinationFolder="$(OutDir)Runtime" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(NoticeFile)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(BundledPluginFile)" DestinationFiles="@(BundledPluginFile->'$(OutDir)BedrockData\plugins\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ProjectDir)..\Native\Console\bin\$(Platform)\$(Configuration)\console.node" DestinationFolder="$(OutDir)BedrockData\plugins\console\native\win32-$(PluginArchitecture)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ProjectDir)..\Native\WindowCustomization\bin\$(Platform)\$(Configuration)\window.node" DestinationFolder="$(OutDir)BedrockData\plugins\window-customization\native\win32-$(PluginArchitecture)" SkipUnchangedFiles="true" />
    <Copy Condition="'$(Platform)'=='x64'" SourceFiles="$(ProjectDir)..\Native\BackdropBlurFix\bin\$(Platform)\$(Configuration)\backdrop-blur-fix.dll" DestinationFolder="$(OutDir)BedrockData\plugins\backdrop-blur-fix\native\win32-x64" SkipUnchangedFiles="true" />
    <Copy Condition="'$(Platform)'=='x64'" SourceFiles="$(ProjectDir)..\Native\BackdropBlurFix\bin\$(Platform)\$(Configuration)\minhook-LICENSE.txt;$(ProjectDir)..\Native\BackdropBlurFix\bin\$(Platform)\$(Configuration)\Skia-LICENSE.txt;$(ProjectDir)..\Native\BackdropBlurFix\bin\$(Platform)\$(Configuration)\Chromium-LICENSE.txt" DestinationFolder="$(OutDir)BedrockData\plugins\backdrop-blur-fix\native\win32-x64" SkipUnchangedFiles="true" />
  </Target>
</Project>
